name: API Test (Newman)

on:
  push:

jobs:
  newman:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: 20

      - name: Install Newman
        run: npm install -g newman

      - name: Run Postman collection
        run: |
          newman run GoRest_API_Testing.postman_collection.json \
            -d users.csv \
            --env-var "token=${{ secrets.GOREST_TOKEN }}"
